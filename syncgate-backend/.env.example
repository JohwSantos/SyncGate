# Copie este arquivo para ".env" e preencha com os valores reais
# do seu ambiente. O arquivo ".env" nunca deve ser enviado ao Git
# (ele já está listado no .gitignore).

# Porta em que a API vai rodar
PORT=3000

# Configuração do banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=syncgate

# Chave secreta usada para assinar os tokens de login (JWT).
# Troque por um valor longo e aleatório em produção.
JWT_SECRET=troque_esta_chave_por_algo_seguro

# Fuso horário do sistema (regras de horário, data/hora dos acessos
# e relatórios). APP_TIMEZONE usa o nome do fuso; DB_TIMEZONE usa o
# deslocamento em relação ao UTC, no formato que o banco entende.
APP_TIMEZONE=America/Sao_Paulo
DB_TIMEZONE=-03:00

# Quantos proxies existem antes da API. Rodando no seu PC: 0.
# Na Azure (App Service / Container Apps): 1.
TRUST_PROXY=0
